# Sanity content source (read-only, public dataset — queried at build time).
# Get the project ID from https://sanity.io/manage after creating the project.
# Set these on Netlify: Site settings → Environment variables.
# Until they're set, the blog simply builds empty — nothing breaks.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Contact form email (Netlify Function → Google Workspace / Gmail SMTP). Set on
# Netlify: Site settings → Environment variables. No extra DNS needed — Google already
# authorises marklyafrica.com for sending. Until these are set, the form returns an
# error and users are pointed to the direct email address instead.
SMTP_USER=hello@marklyafrica.com
# 16-char App Password for SMTP_USER (Google account → Security → App passwords;
# requires 2-Step Verification). Spaces are fine — the function strips them.
SMTP_PASS=
# Optional overrides (sensible defaults are baked into the function):
# CONTACT_FROM="Markly Africa <hello@marklyafrica.com>"
# CONTACT_TEAM="hello@marklyafrica.com,woye.famojuro@marklyafrica.com"
