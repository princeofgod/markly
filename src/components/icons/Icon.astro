---
import type { IconName } from '../../types';
import ShieldIcon from './ShieldIcon.astro';
import ScaleIcon from './ScaleIcon.astro';
import LedgerIcon from './LedgerIcon.astro';
import GlobeIcon from './GlobeIcon.astro';
import LightbulbIcon from './LightbulbIcon.astro';
import UsersIcon from './UsersIcon.astro';
import ChartIcon from './ChartIcon.astro';
import ClipboardIcon from './ClipboardIcon.astro';
import SealCheckIcon from './SealCheckIcon.astro';
import CheckIcon from './CheckIcon.astro';

const icons = {
	shield: ShieldIcon,
	scale: ScaleIcon,
	ledger: LedgerIcon,
	globe: GlobeIcon,
	lightbulb: LightbulbIcon,
	users: UsersIcon,
	chart: ChartIcon,
	clipboard: ClipboardIcon,
	'seal-check': SealCheckIcon,
	check: CheckIcon,
} satisfies Record<IconName, unknown>;

interface Props {
	name: IconName;
	class?: string;
}

const { name, class: className = 'h-6 w-6' } = Astro.props;
const IconComponent = icons[name];
---

<IconComponent class={className} />
