---
import Container from '../layout/Container.astro';
import SectionHeading from '../common/SectionHeading.astro';
import ButtonSecondary from '../common/ButtonSecondary.astro';
import Icon from '../icons/Icon.astro';
import { services } from '../../data/services';
---

<section class="bg-surface py-16 md:py-24">
	<Container class="flex flex-col gap-12">
		<SectionHeading
			eyebrow="What We Do"
			title="Services Built for Compliance, Protection, and Growth"
			subtitle="A full-service advisory practice covering the legal, regulatory, and strategic needs of modern businesses."
		/>

		<div class="flex flex-col border-t border-border-subtle">
			{
				services.map((service, index) => (
					<div class="grid grid-cols-[2.5rem_1fr] items-start gap-x-4 gap-y-3 border-b border-border-subtle py-6 sm:grid-cols-[3.5rem_3rem_15rem_1fr] sm:items-center sm:gap-x-6">
						<span class="font-display text-sm text-muted">§{String(index + 1).padStart(2, '0')}</span>
						<span class="hidden h-10 w-10 items-center justify-center rounded-full bg-accent/10 text-primary sm:inline-flex">
							<Icon name={service.icon} class="h-5 w-5" />
						</span>
						<h3 class="font-display text-xl text-primary">{service.title}</h3>
						<p class="col-span-2 leading-[1.5] text-muted sm:col-span-1">{service.summary}</p>
					</div>
				))
			}
		</div>

		<div class="flex justify-center">
			<ButtonSecondary href="/services">Explore All Services</ButtonSecondary>
		</div>
	</Container>
</section>
