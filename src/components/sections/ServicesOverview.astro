---
import Container from '../layout/Container.astro';
import SectionHeading from '../common/SectionHeading.astro';
import ButtonSecondary from '../common/ButtonSecondary.astro';
import { services } from '../../data/services';
---

<section class="bg-surface-sunken py-16 md:py-20">
	<Container class="flex flex-col gap-12">
		<div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
			<SectionHeading
				title="Services built for compliance, protection, and growth"
				subtitle="A full-service advisory practice covering the legal, regulatory, and strategic needs of modern businesses."
				size="sm"
				class="mx-0"
			/>
			<div class="hidden flex-none md:block">
				<ButtonSecondary href="/services">Explore All Services</ButtonSecondary>
			</div>
		</div>

		{/* Lean index: the full breadth of the practice, each name deep-linking to
		    its section on /services. Replaces the previous 7-card matrix — same
		    information, a fraction of the height, no wall-of-cards density.

		    The list is a [data-reveal-group]: its rows cascade up in DOM order on
		    scroll, and as each row settles its arrow does a single horizontal
		    drift (see [data-reveal-nudge] in global.css) — a one-shot flourish
		    that teaches the affordance, then rests. The per-row --i drives both
		    the row stagger and the arrow-drift delay so they read as one gesture. */}
		<ul
			data-reveal-group
			class="grid grid-cols-1 border-t border-border-subtle sm:grid-cols-2 sm:gap-x-12 lg:gap-x-16"
		>
			{
				services.map((service, index) => (
					<li style={`--i: ${index}`}>
						<a
							href={`/services#${service.slug}`}
							class="group flex items-baseline justify-between gap-6 border-b border-border-subtle py-5 transition-colors duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:border-primary/40 focus-visible:relative focus-visible:z-10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
						>
							<span class="font-display text-lg font-medium leading-snug text-primary md:text-xl">
								{service.title}
							</span>
							<span
								class="flex-none text-primary/35 transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:translate-x-1 group-hover:text-primary motion-reduce:transition-none"
								aria-hidden="true"
								data-reveal-nudge
							>
								&rarr;
							</span>
						</a>
					</li>
				))
			}
		</ul>

		<div class="flex justify-center md:hidden">
			<ButtonSecondary href="/services">Explore All Services</ButtonSecondary>
		</div>
	</Container>
</section>
