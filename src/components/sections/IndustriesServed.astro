---
import Container from '../layout/Container.astro';
import SectionHeading from '../common/SectionHeading.astro';
import { industries } from '../../data/industries';
---

<section class="bg-surface-sunken py-16 md:py-20">
	<Container>
		<div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-start lg:gap-12">
			<div data-reveal class="lg:col-span-4">
				<SectionHeading
					title="Advisory built for organizations across every sector"
					subtitle="From first-time founders to established institutions, we tailor compliance, protection, and growth strategy to your context."
					size="sm"
					class="mx-0 max-w-none"
				/>
			</div>
			<div class="lg:col-span-8 lg:pt-2">
				<ul data-reveal-group class="flex flex-wrap items-center gap-x-6 gap-y-3.5">
					{
						industries.map((sector, index) => (
							<li
								style={`--i: ${index}`}
								class="flex items-center gap-2.5 text-[0.95rem] font-medium leading-none text-ink/80"
							>
								<span class="h-1 w-1 flex-none rounded-full bg-accent" aria-hidden="true" />
								{sector}
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</Container>
</section>
