---
import Container from '../layout/Container.astro';
import SectionHeading from '../common/SectionHeading.astro';
import Icon from '../icons/Icon.astro';
import { valuePropositions } from '../../data/valuePropositions';
---

<section class="bg-surface-alt py-16 md:py-24">
	<Container class="flex flex-col gap-12">
		<SectionHeading
			eyebrow="Our Value"
			title="Value Beyond Advisory"
			subtitle="Three pillars guide every engagement, from first consultation to long-term partnership."
		/>

		<div class="flex flex-col border-t border-border-subtle">
			{
				valuePropositions.map((pillar, index) => (
					<div
						data-reveal
						style={`transition-delay: ${index * 120}ms`}
						class="grid grid-cols-1 gap-6 border-b border-border-subtle py-10 lg:grid-cols-12 lg:gap-10 lg:py-12"
					>
						<div class="flex items-start gap-4 lg:col-span-4">
							<span class="inline-flex h-12 w-12 flex-none items-center justify-center rounded-full bg-accent/10 text-primary">
								<Icon name={pillar.icon} class="h-6 w-6" />
							</span>
							<div class="flex flex-col gap-1">
								<span class="font-display text-sm italic text-accent">Exhibit {String.fromCharCode(65 + index)}</span>
								<h3 class="font-display text-2xl text-primary">{pillar.title}</h3>
							</div>
						</div>

						<div class="flex flex-col gap-3 lg:col-span-8">
							<p class="text-sm leading-[1.5] text-muted line-through decoration-accent decoration-1 [text-decoration-skip-ink:none]">
								{pillar.problem}
							</p>
							<p class="font-display text-lg italic leading-[1.5] text-primary">{pillar.solution}</p>
							<p class="text-base font-semibold leading-[1.5] text-primary">{pillar.value}</p>
						</div>
					</div>
				))
			}
		</div>
	</Container>
</section>
