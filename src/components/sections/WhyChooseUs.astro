---
import Container from '../layout/Container.astro';
import SectionHeading from '../common/SectionHeading.astro';
import Icon from '../icons/Icon.astro';
import { differentiators } from '../../data/differentiators';

const [featured, ...rest] = differentiators;
---

<section class="bg-surface py-16 md:py-24">
	<Container class="flex flex-col gap-12">
		<SectionHeading
			title="Smarter compliance. Faster protection."
			subtitle="Our platform combines artificial intelligence with professional expertise to deliver efficient, reliable, and cost-effective solutions."
			class="mx-0"
		/>

		<div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
			<div
				data-reveal
				class="relative flex flex-col justify-between gap-10 overflow-hidden rounded-xl bg-primary-950 p-8 text-surface md:p-10 lg:col-span-5"
			>
				<div
					class="animate-aura pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full bg-accent/25 blur-[90px] motion-reduce:animate-none"
					aria-hidden="true"
				>
				</div>
				<span class="relative inline-flex h-14 w-14 flex-none items-center justify-center rounded-lg bg-accent text-primary">
					<Icon name={featured.icon} class="h-7 w-7" />
				</span>
				<div class="relative flex flex-col gap-3">
					<h3 class="font-display text-2xl font-semibold leading-[1.15] md:text-3xl">{featured.title}</h3>
					<p class="max-w-md text-lg leading-[1.55] text-surface/75">{featured.description}</p>
				</div>
			</div>

			<div class="grid grid-cols-1 gap-x-8 gap-y-8 sm:grid-cols-2 lg:col-span-7">
				{
					rest.map((item, index) => (
						<div data-reveal style={`--i: ${index}`} class="flex flex-col gap-3">
							<span class="inline-flex h-11 w-11 items-center justify-center rounded-md bg-primary/8 text-primary">
								<Icon name={item.icon} class="h-5 w-5" />
							</span>
							<h3 class="font-display text-lg font-semibold text-primary">{item.title}</h3>
							<p class="text-[0.95rem] leading-[1.55] text-muted">{item.description}</p>
						</div>
					))
				}
			</div>
		</div>
	</Container>
</section>
