---
import Container from '../layout/Container.astro';
import SectionHeading from '../common/SectionHeading.astro';
import Icon from '../icons/Icon.astro';
import ReviewedSeal from '../common/ReviewedSeal.astro';
import { differentiators } from '../../data/differentiators';

const [featured, ...rest] = differentiators;
---

<section class="bg-surface py-16 md:py-24">
	<Container class="flex flex-col gap-12">
		<SectionHeading
			eyebrow="Why Choose Us?"
			title="Smarter Compliance. Faster Protection."
			subtitle="Our platform combines artificial intelligence with professional expertise to deliver efficient, reliable, and cost-effective solutions."
		/>

		<div class="flex flex-col gap-10">
			<div data-reveal class="flex flex-col gap-6 rounded-2xl bg-primary p-8 text-surface md:flex-row md:items-center md:gap-10 md:p-10">
				<span class="inline-flex h-14 w-14 flex-none items-center justify-center rounded-full bg-accent/20 text-accent">
					<Icon name={featured.icon} class="h-7 w-7" />
				</span>
				<div class="flex flex-col gap-3">
					<div class="flex flex-wrap items-center gap-3">
						<h3 class="font-display text-2xl md:text-3xl">{featured.title}</h3>
						<span data-reveal="seal" style="transition-delay: 200ms" class="inline-block">
							<ReviewedSeal tone="inverted" label="Every output, human-reviewed" />
						</span>
					</div>
					<p class="max-w-2xl leading-[1.5] text-surface/80">{featured.description}</p>
				</div>
			</div>

			<div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
				{
					rest.map((item, index) => (
						<div data-reveal style={`transition-delay: ${index * 100}ms`} class="flex flex-col gap-3">
							<span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-accent/10 text-primary">
								<Icon name={item.icon} class="h-5 w-5" />
							</span>
							<h3 class="font-display text-lg text-primary">{item.title}</h3>
							<p class="leading-[1.5] text-muted">{item.description}</p>
						</div>
					))
				}
			</div>
		</div>
	</Container>
</section>
