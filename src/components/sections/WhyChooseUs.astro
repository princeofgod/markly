---
import Container from '../layout/Container.astro';
import SectionHeading from '../common/SectionHeading.astro';
import Icon from '../icons/Icon.astro';
import { differentiators } from '../../data/differentiators';
---

<section class="bg-surface py-16 md:py-24">
	<Container class="flex flex-col gap-12">
		<SectionHeading
			eyebrow="Why Choose Markly"
			title="A Different Kind of Advisory Partner"
			subtitle="We combine AI-driven efficiency with human-supervised expertise to deliver advice you can act on."
		/>

		<div class="grid grid-cols-1 gap-8 sm:grid-cols-2">
			{
				differentiators.map((item) => (
					<div class="flex gap-4">
						<span class="mt-1 inline-flex h-10 w-10 flex-none items-center justify-center rounded-full bg-primary text-surface">
							<Icon name={item.icon} class="h-5 w-5" />
						</span>
						<div class="flex flex-col gap-2">
							<h3 class="font-display text-lg text-primary">{item.title}</h3>
							<p class="leading-[1.5] text-muted">{item.description}</p>
						</div>
					</div>
				))
			}
		</div>
	</Container>
</section>
