---
import Container from '../layout/Container.astro';
import ButtonPrimary from '../common/ButtonPrimary.astro';

interface Props {
	title: string;
	subtitle?: string;
	ctaLabel: string;
	ctaHref: string;
	note?: string;
	image?: { src: string; alt: string };
}

const {
	title,
	subtitle,
	ctaLabel,
	ctaHref,
	note = 'No obligation — a free, no-pressure conversation.',
	image,
} = Astro.props;
---

<section class="bg-surface py-16 md:py-24">
	<Container>
		<div
			class="relative overflow-hidden rounded-2xl bg-primary-950 px-6 py-14 text-surface sm:px-10 md:px-14 md:py-20"
		>
			<div
				class="animate-aura pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full bg-accent/25 blur-[110px] motion-reduce:animate-none"
				aria-hidden="true"
			>
			</div>
			<div
				class="pointer-events-none absolute -bottom-28 -left-20 h-72 w-72 rounded-full bg-primary-700/50 blur-[120px]"
				aria-hidden="true"
			>
			</div>

			{
				image ? (
					<div class="relative lg:grid lg:grid-cols-12 lg:items-center lg:gap-14">
						<div class="flex flex-col gap-6 lg:col-span-7">
							<h2 class="font-display text-3xl font-semibold leading-[1.12] md:text-[2.6rem]">
								{title}
							</h2>
							{subtitle && (
								<p class="max-w-[58ch] text-lg leading-[1.6] text-surface/75">{subtitle}</p>
							)}
							<div class="mt-2 flex flex-col items-start gap-3">
								<ButtonPrimary href={ctaHref}>{ctaLabel}</ButtonPrimary>
								{note && <p class="text-sm leading-relaxed text-surface/70">{note}</p>}
							</div>
						</div>
						<div class="mt-10 lg:col-span-5 lg:mt-0">
							<img
								src={image.src}
								alt={image.alt}
								width="1200"
								height="900"
								loading="lazy"
								class="aspect-[4/3] w-full rounded-xl object-cover ring-1 ring-surface/15"
							/>
						</div>
					</div>
				) : (
					<div class="relative flex flex-col gap-10 lg:flex-row lg:items-center lg:justify-between lg:gap-14">
						<div class="flex flex-col gap-6 lg:max-w-2xl">
							<h2 class="font-display text-3xl font-semibold leading-[1.12] md:text-[2.6rem]">
								{title}
							</h2>
							{subtitle && (
								<p class="max-w-[58ch] text-lg leading-[1.6] text-surface/75">{subtitle}</p>
							)}
						</div>
						<div class="flex flex-none flex-col items-start gap-3 lg:items-end lg:text-right">
							<ButtonPrimary href={ctaHref}>{ctaLabel}</ButtonPrimary>
							{note && (
								<p class="max-w-[30ch] text-sm leading-relaxed text-surface/70">{note}</p>
							)}
						</div>
					</div>
				)
			}
		</div>
	</Container>
</section>
