---
import Container from '../layout/Container.astro';
import ButtonPrimary from '../common/ButtonPrimary.astro';
import ReviewedSeal from '../common/ReviewedSeal.astro';

interface Props {
	title: string;
	subtitle?: string;
	ctaLabel: string;
	ctaHref: string;
	tone?: 'dark' | 'light';
	image?: { src: string; alt: string };
}

const { title, subtitle, ctaLabel, ctaHref, tone = 'light', image } = Astro.props;
const isDark = tone === 'dark';
const sectionBg = isDark ? 'bg-primary' : 'bg-surface';
const titleColor = isDark ? 'text-surface' : 'text-primary';
const subtitleColor = isDark ? 'text-surface/70' : 'text-muted';
const sealTone = isDark ? 'inverted' : 'default';
---

<section class={`${sectionBg} py-16 md:py-24`}>
	<Container>
		<div class:list={['flex flex-col gap-12', image && 'lg:grid lg:grid-cols-12 lg:items-center lg:gap-16']}>
			<div
				class:list={[
					'flex flex-col gap-6',
					image ? 'items-start text-left lg:order-2 lg:col-span-7' : 'items-center text-center',
				]}
			>
				<h2 class={`font-display text-3xl leading-[1.5] md:text-4xl ${image ? 'max-w-xl' : 'max-w-2xl'} ${titleColor}`}>
					{title}
				</h2>
				{subtitle && <p class={`max-w-[65ch] leading-[1.5] ${subtitleColor}`}>{subtitle}</p>}
				<ButtonPrimary href={ctaHref}>{ctaLabel}</ButtonPrimary>
				<span data-reveal="seal" class="inline-block">
					<ReviewedSeal tone={sealTone} label="Reviewed by a human expert" class="max-w-full" />
				</span>
			</div>
			{
				image && (
					<div class="lg:order-1 lg:col-span-5">
						<img
							src={image.src}
							alt={image.alt}
							width="1200"
							height="1500"
							loading="lazy"
							class="aspect-[4/5] w-full rounded-2xl border border-border-subtle object-cover"
						/>
					</div>
				)
			}
		</div>
	</Container>
</section>
