---
import Container from '../layout/Container.astro';
import SectionHeading from '../common/SectionHeading.astro';
import Icon from '../icons/Icon.astro';
import { howItWorks } from '../../data/howItWorks';
---

<section class="bg-surface-alt py-16 md:py-24">
	<Container class="flex flex-col gap-12">
		<SectionHeading title="A smarter way to protect your brand" align="left" class="mx-0" />

		<ol class="grid grid-cols-1 gap-6 md:grid-cols-3 md:gap-8">
			{
				howItWorks.map((step, index) => (
					<li data-reveal style={`transition-delay: ${index * 90}ms`} class="[perspective:1200px]">
						<div class="group relative flex h-full flex-col gap-5 rounded-xl border border-border-subtle bg-surface p-8 shadow-[var(--shadow-card)] transition-[transform,box-shadow,border-color] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] will-change-transform hover:-translate-y-1.5 hover:-rotate-x-3 hover:scale-[1.02] hover:border-border-strong hover:shadow-[var(--shadow-lift)] motion-reduce:transition-none motion-reduce:hover:translate-none motion-reduce:hover:scale-100 motion-reduce:hover:rotate-x-0">
							<div class="flex items-center justify-between">
								<span class="inline-flex h-12 w-12 flex-none items-center justify-center rounded-lg bg-primary/8 text-primary transition-colors duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:bg-accent group-hover:text-primary">
									<Icon name={step.icon} class="h-5 w-5" />
								</span>
								<span class="font-display text-4xl font-semibold leading-none text-primary/15">
									{String(index + 1).padStart(2, '0')}
								</span>
							</div>
							<div class="flex flex-col gap-2">
								<h3 class="font-display text-xl font-semibold text-primary">{step.title}</h3>
								<p class="leading-[1.55] text-muted">{step.description}</p>
							</div>
						</div>
					</li>
				))
			}
		</ol>
	</Container>
</section>
