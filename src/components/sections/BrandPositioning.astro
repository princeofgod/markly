---
import Container from '../layout/Container.astro';
import SectionHeading from '../common/SectionHeading.astro';
import ButtonPrimary from '../common/ButtonPrimary.astro';
import BrandPositioningGraphic from './BrandPositioningGraphic.astro';
import { company } from '../../data/company';
---

<section class="overflow-hidden bg-surface py-16 md:py-24">
	<Container>
		<div data-reveal-group class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-center lg:gap-16">
			<div class="reveal-converge-left lg:col-span-5">
				<div class="relative">
					<div class="absolute -inset-2 -z-10 rounded-[1.75rem] bg-primary/5 blur-xl" aria-hidden="true"></div>
					<BrandPositioningGraphic />
				</div>
			</div>

			<div class="reveal-converge-right flex flex-col gap-6 lg:col-span-7">
				<SectionHeading
					kicker="Who We Are"
					title="Protecting innovation. Ensuring compliance. Empowering growth."
					align="left"
					class="mx-0 max-w-none"
				/>
				<p class="max-w-[62ch] text-lg leading-[1.6] text-muted">
					{company.description}
				</p>
				<p class="max-w-[62ch] text-lg leading-[1.6] text-muted">
					We provide practical, strategic, and AI-driven solutions that enable our clients to operate confidently,
					protect valuable assets, and scale sustainably across Africa and global markets.
				</p>
				<p class="max-w-[52ch] font-display text-xl font-medium leading-[1.4] text-primary">
					Your trusted partner in compliance, innovation, and business success.
				</p>
				<div class="mt-2">
					<ButtonPrimary href="/contact">Book a Consultation</ButtonPrimary>
				</div>
			</div>
		</div>
	</Container>
</section>
