---
import Container from '../layout/Container.astro';
import ButtonPrimary from '../common/ButtonPrimary.astro';
import ButtonSecondary from '../common/ButtonSecondary.astro';

interface CtaLink {
	label: string;
	href: string;
}

interface Props {
	kicker?: string;
	title?: string;
	subtitle?: string;
	primaryCta?: CtaLink;
	secondaryCta?: CtaLink;
	variant?: 'default' | 'compact';
	tone?: 'dark' | 'light';
	image?: { src: string; alt: string };
}

const { kicker, title, subtitle, primaryCta, secondaryCta, variant = 'default', tone = 'dark', image } = Astro.props;

const isDark = tone === 'dark';
const isCompact = variant === 'compact';
const hasTitleSlot = Astro.slots.has('title');
const hasMediaSlot = Astro.slots.has('media');
// A supplied image OR a custom media slot (e.g. an animated brand graphic) both
// trigger the photography-led split layout.
const hasImage = Boolean(image) || hasMediaSlot;

const sectionBg = isDark ? 'bg-primary-950' : 'bg-surface';
const titleColor = isDark ? 'text-surface' : 'text-primary';
const subtitleColor = isDark ? 'text-surface/70' : 'text-muted';
const kickerColor = isDark ? 'text-surface/70' : 'text-primary/60';

const paddingClass = isCompact ? 'pt-16 pb-14 md:pt-20 md:pb-16' : 'pt-16 pb-20 md:pt-24 md:pb-28';

// A photography-led split layout when an image is supplied; otherwise a
// centered (compact interior) or left-aligned single column.
const gridClass = hasImage
	? 'grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-16'
	: isCompact
		? 'flex max-w-3xl flex-col items-start gap-6'
		: 'flex max-w-3xl flex-col items-start gap-6';

const titleSize = isCompact
	? 'text-[2.25rem] leading-[1.08] sm:text-5xl'
	: 'text-[2.6rem] leading-[1.05] sm:text-5xl md:text-6xl';
---

<section class={`relative overflow-hidden ${sectionBg} ${paddingClass}`}>
	{
		isDark && (
			<>
				<div
					class="animate-aura pointer-events-none absolute -right-[10%] -top-[30%] h-[36rem] w-[36rem] rounded-full bg-accent/25 blur-[120px] motion-reduce:animate-none"
					aria-hidden="true"
				/>
				<div
					class="pointer-events-none absolute -bottom-[35%] -left-[12%] h-[32rem] w-[32rem] rounded-full bg-primary-700/45 blur-[130px]"
					aria-hidden="true"
				/>
				<div
					class="animate-float pointer-events-none absolute bottom-[16%] left-[45%] hidden h-16 w-16 rounded-full border border-accent/30 motion-reduce:animate-none lg:block"
					aria-hidden="true"
				/>
				<div
					class="animate-float-slow pointer-events-none absolute bottom-[26%] left-[6%] hidden h-2.5 w-2.5 rounded-full bg-accent/50 motion-reduce:animate-none lg:block"
					aria-hidden="true"
				/>
				<div
					class="animate-drift pointer-events-none absolute left-[38%] top-[22%] hidden h-4 w-4 rounded-full bg-accent/60 motion-reduce:animate-none lg:block"
					aria-hidden="true"
				/>
				<div
					class="animate-orbit pointer-events-none absolute bottom-[44%] left-[3%] hidden h-5 w-5 rounded-full border border-accent/40 motion-reduce:animate-none lg:block"
					aria-hidden="true"
				/>
			</>
		)
	}

	<Container class="relative">
		<div class={gridClass}>
			<div class={hasImage ? 'flex flex-col items-start gap-6 lg:col-span-6' : 'contents'}>
				{
					kicker && (
						<span
							class={`animate-rise-in flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.2em] ${kickerColor}`}
						>
							<span class="h-px w-8 flex-none bg-accent" aria-hidden="true" />
							{kicker}
						</span>
					)
				}
				<h1
					class={`animate-rise-in font-display font-semibold tracking-[-0.02em] ${titleSize} ${titleColor}`}
					style="animation-delay: 80ms"
				>
					{hasTitleSlot ? <slot name="title" /> : title}
				</h1>
				{
					subtitle && (
						<p
							class={`animate-rise-in max-w-[60ch] text-lg leading-[1.6] md:text-xl ${subtitleColor}`}
							style="animation-delay: 160ms"
						>
							{subtitle}
						</p>
					)
				}
				{
					(primaryCta || secondaryCta) && (
						<div class="animate-rise-in mt-2 flex flex-col gap-4 sm:flex-row sm:items-center" style="animation-delay: 240ms">
							{primaryCta && <ButtonPrimary href={primaryCta.href}>{primaryCta.label}</ButtonPrimary>}
							{secondaryCta && (
								<ButtonSecondary href={secondaryCta.href} variant={isDark ? 'inverted' : 'default'}>
									{secondaryCta.label}
								</ButtonSecondary>
							)}
						</div>
					)
				}
			</div>

			{
				hasImage && (
					<div class="animate-rise-in relative lg:col-span-6" style="animation-delay: 200ms">
						<div class="absolute -inset-3 -z-10 rounded-[2rem] bg-accent/20 blur-2xl" aria-hidden="true" />
						{hasMediaSlot ? (
							<slot name="media" />
						) : (
							<img
								src={image!.src}
								alt={image!.alt}
								width="1200"
								height="900"
								fetchpriority="high"
								decoding="async"
								class="aspect-[4/3] w-full rounded-2xl object-cover shadow-[var(--shadow-lift)] ring-1 ring-surface/15"
							/>
						)}
					</div>
				)
			}
		</div>
	</Container>
</section>
