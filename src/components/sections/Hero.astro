---
import Container from '../layout/Container.astro';
import ButtonPrimary from '../common/ButtonPrimary.astro';
import ButtonSecondary from '../common/ButtonSecondary.astro';

interface CtaLink {
	label: string;
	href: string;
}

interface Props {
	eyebrow?: string;
	title: string;
	subtitle?: string;
	primaryCta?: CtaLink;
	secondaryCta?: CtaLink;
	variant?: 'default' | 'compact';
}

const { eyebrow, title, subtitle, primaryCta, secondaryCta, variant = 'default' } = Astro.props;

const paddingClass = variant === 'compact' ? 'py-16 md:py-20' : 'py-20 md:py-32';
---

<section class={`bg-surface ${paddingClass}`}>
	<Container class="flex flex-col items-center gap-8 text-center">
		{eyebrow && <span class="text-sm font-semibold uppercase tracking-wide text-accent">{eyebrow}</span>}
		<h1 class="max-w-4xl font-display text-4xl leading-[1.5] text-primary md:text-6xl">
			{title}
		</h1>
		{subtitle && <p class="max-w-2xl text-lg leading-[1.5] text-muted md:text-xl">{subtitle}</p>}
		{
			(primaryCta || secondaryCta) && (
				<div class="mt-4 flex flex-col items-center gap-4 sm:flex-row">
					{primaryCta && <ButtonPrimary href={primaryCta.href}>{primaryCta.label}</ButtonPrimary>}
					{secondaryCta && <ButtonSecondary href={secondaryCta.href}>{secondaryCta.label}</ButtonSecondary>}
				</div>
			)
		}
	</Container>
</section>
