---
import type { Article } from '../../types';
import { imageUrl } from '../../lib/sanity';

interface Props {
	article: Article;
	/** Eager-load the first card's image (above the fold on /insights). */
	priority?: boolean;
}

const { article, priority = false } = Astro.props;
const { title, slug, excerpt, coverImage, category, publishedAt } = article;

const date = new Date(publishedAt);
const dateLabel = date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<article
	class="group flex h-full flex-col overflow-hidden rounded-xl border border-border-subtle bg-surface-alt shadow-[var(--shadow-card)] transition-[transform,box-shadow,border-color] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1 hover:border-border-strong hover:shadow-[var(--shadow-lift)] motion-reduce:transition-none motion-reduce:hover:translate-none"
>
	<a href={`/insights/${slug}`} class="flex h-full flex-col focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
		{
			coverImage?.url && (
				<div class="aspect-[16/9] overflow-hidden bg-surface-sunken">
					<img
						src={imageUrl(coverImage.url, { w: 800, h: 450 })}
						alt={coverImage.alt || ''}
						width="800"
						height="450"
						loading={priority ? 'eager' : 'lazy'}
						decoding="async"
						class="h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
					/>
				</div>
			)
		}

		<div class="flex flex-1 flex-col gap-3 p-6">
			<div class="flex items-center gap-2.5 text-xs font-semibold text-primary/60">
				<span>{category}</span>
				<span class="h-1 w-1 flex-none rounded-full bg-accent" aria-hidden="true"></span>
				<time datetime={publishedAt} class="font-medium text-muted">{dateLabel}</time>
			</div>

			<h3 class="font-display text-xl font-semibold leading-snug text-primary">{title}</h3>

			<p class="line-clamp-3 text-[0.95rem] leading-relaxed text-muted">{excerpt}</p>

			<span
				class="mt-auto inline-flex items-center gap-1.5 pt-2 text-sm font-semibold text-primary transition-colors duration-300 group-hover:text-accent"
			>
				Read article
				<span
					class="transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:translate-x-1 motion-reduce:transition-none"
					aria-hidden="true">&rarr;</span
				>
			</span>
		</div>
	</a>
</article>
