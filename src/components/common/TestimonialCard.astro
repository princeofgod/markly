---
import Card from './Card.astro';
import type { Testimonial } from '../../types';
import { cn } from '../../utils/cn';

interface Props {
	testimonial: Testimonial;
	class?: string;
}

const { testimonial, class: className = '' } = Astro.props;
---

<Card as="figure" class={cn('flex h-full flex-col justify-between gap-6', className)}>
	<blockquote class="text-lg leading-[1.5] text-primary">
		<p>&ldquo;{testimonial.quote}&rdquo;</p>
	</blockquote>
	<figcaption class="text-sm font-semibold text-muted">
		{testimonial.author}
		{testimonial.role && <span class="font-normal text-muted">, {testimonial.role}</span>}
		{testimonial.company && <span class="font-normal text-muted"> &middot; {testimonial.company}</span>}
	</figcaption>
</Card>
