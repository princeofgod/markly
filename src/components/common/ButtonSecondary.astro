---
import { cn } from '../../utils/cn';

interface Props {
	href?: string;
	type?: 'button' | 'submit';
	variant?: 'default' | 'inverted';
	class?: string;
}

const { href, type = 'button', variant = 'default', class: className = '' } = Astro.props;

const variantClasses =
	variant === 'inverted'
		? cn('border-surface/35 text-surface hover:border-surface hover:bg-surface hover:text-primary')
		: cn('border-primary/25 text-primary hover:border-primary hover:bg-primary hover:text-surface');

const classes = cn(
	'inline-flex items-center justify-center gap-2 rounded-md border px-6 py-3',
	'text-[0.95rem] font-semibold',
	'transition-[background-color,color,border-color,transform] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)]',
	'hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98]',
	'motion-reduce:transition-none motion-reduce:hover:translate-none',
	variantClasses,
	className,
);
---

{
	href ? (
		<a href={href} class={classes}>
			<slot />
		</a>
	) : (
		<button type={type} class={classes}>
			<slot />
		</button>
	)
}
