---
import { cn } from '../../utils/cn';

interface Props {
	href?: string;
	type?: 'button' | 'submit';
	variant?: 'default' | 'inverted';
	class?: string;
}

const { href, type = 'button', variant = 'default', class: className = '' } = Astro.props;

const variantClasses =
	variant === 'inverted'
		? cn(
				'border-surface text-surface',
				'hover:bg-surface hover:text-primary',
				'focus-visible:outline-surface',
			)
		: cn('border-primary text-primary', 'hover:bg-primary hover:text-surface', 'focus-visible:outline-primary');

const classes = cn(
	'inline-flex items-center justify-center gap-2 rounded-full border-2 px-6 py-3',
	'text-base font-semibold',
	'transition-all duration-300 ease-in-out active:scale-[0.98]',
	'focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2',
	variantClasses,
	className,
);
---

{
	href ? (
		<a href={href} class={classes}>
			<slot />
		</a>
	) : (
		<button type={type} class={classes}>
			<slot />
		</button>
	)
}
