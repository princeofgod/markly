---
import { cn } from '../../utils/cn';

interface Props {
	href?: string;
	type?: 'button' | 'submit';
	class?: string;
}

const { href, type = 'button', class: className = '' } = Astro.props;

const classes = cn(
	'inline-flex items-center justify-center gap-2 rounded-full bg-accent px-6 py-3',
	'text-base font-semibold text-primary',
	'transition-all duration-300 ease-in-out hover:bg-primary hover:text-surface-alt active:scale-[0.98]',
	'focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
	'disabled:pointer-events-none disabled:opacity-50 disabled:active:scale-100',
	className,
);
---

{
	href ? (
		<a href={href} class={classes}>
			<slot />
		</a>
	) : (
		<button type={type} class={classes}>
			<slot />
		</button>
	)
}
