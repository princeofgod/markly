---
import { cn } from '../../utils/cn';

interface Props {
	class?: string;
	as?: 'div' | 'figure' | 'article';
}

const { class: className = '', as: Tag = 'div' } = Astro.props;

const classes = cn(
	'rounded-lg border border-border-subtle bg-surface-alt p-7 shadow-[var(--shadow-card)]',
	'transition-[transform,box-shadow,border-color] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)]',
	'hover:-translate-y-1 hover:border-border-strong hover:shadow-[var(--shadow-lift)]',
	'motion-reduce:transition-none motion-reduce:hover:translate-none',
	className,
);
---

<Tag class={classes}>
	<slot />
</Tag>
