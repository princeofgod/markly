---
import { cn } from '../../utils/cn';

interface Props {
	class?: string;
	as?: 'div' | 'figure' | 'article';
}

const { class: className = '', as: Tag = 'div' } = Astro.props;

const classes = cn(
	'rounded-2xl border border-border-subtle bg-surface-alt p-6 shadow-sm',
	'transition-all duration-300 ease-in-out hover:shadow-md',
	className,
);
---

<Tag class={classes}>
	<slot />
</Tag>
