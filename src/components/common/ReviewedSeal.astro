---
import Icon from '../icons/Icon.astro';
import { cn } from '../../utils/cn';

interface Props {
	label?: string;
	tone?: 'default' | 'inverted' | 'solid';
	class?: string;
}

const { label = 'Human-reviewed', tone = 'default', class: className = '' } = Astro.props;
const toneClass =
	tone === 'inverted'
		? 'border-surface/40 bg-surface/10 text-surface'
		: tone === 'solid'
			? 'border-accent/40 bg-surface-alt text-primary shadow-md'
			: 'border-accent/40 bg-accent/10 text-primary';
---

<span
	class={cn(
		'inline-flex items-center gap-1.5 rounded-full border px-3 py-1',
		'text-xs font-semibold uppercase tracking-wide',
		toneClass,
		className,
	)}
>
	<Icon name="check" class="h-3.5 w-3.5 text-accent" />
	{label}
</span>
