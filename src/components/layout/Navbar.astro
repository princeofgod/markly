---
import Container from './Container.astro';
import MobileMenu from './MobileMenu.astro';
import ButtonPrimary from '../common/ButtonPrimary.astro';
import { mainNavigation } from '../../data/navigation';
import { company } from '../../data/company';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-border-subtle bg-surface-alt/95 backdrop-blur">
	<Container as="nav" class="flex h-20 items-center justify-between">
		<a
			href="/"
			class="font-display text-2xl font-semibold text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
		>
			{company.name}
		</a>

		<ul class="hidden items-center gap-8 md:flex">
			{
				mainNavigation.map((item) => {
					const isActive = currentPath === item.href;
					return (
						<li>
							<a
								href={item.href}
								aria-current={isActive ? 'page' : undefined}
								class={`text-sm font-medium transition-all duration-300 ease-in-out hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent ${isActive ? 'text-accent' : 'text-primary'}`}
							>
								{item.label}
							</a>
						</li>
					);
				})
			}
		</ul>

		<div class="hidden md:block">
			<ButtonPrimary href="/contact">Book a Consultation</ButtonPrimary>
		</div>

		<MobileMenu navigation={mainNavigation} />
	</Container>
</header>
