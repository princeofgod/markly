---
import MainLayout from '../layouts/MainLayout.astro';
import Container from '../components/layout/Container.astro';
import Hero from '../components/sections/Hero.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import ServicesPipelineGraphic from '../components/sections/ServicesPipelineGraphic.astro';
import CTASection from '../components/sections/CTASection.astro';
import SectionHeading from '../components/common/SectionHeading.astro';
import Icon from '../components/icons/Icon.astro';
import { services } from '../data/services';
import { industries } from '../data/industries';

const marqueeItems = [...industries, ...industries];
---

<MainLayout
	title="Trademark, IP & Data Protection Services"
	description="Data protection & NDPA/NDPR compliance, DPO-as-a-Service, trademark registration, brand enforcement, and IP advisory in Nigeria and across Africa."
>
	<Hero
		variant="compact"
		tone="dark"
		kicker="What we do"
		title="A full-service advisory practice, built for compliance, protection, and growth."
		subtitle="From data protection to trademarks to startup advisory, every engagement is drafted with AI and reviewed by a qualified professional before it reaches you."
		primaryCta={{ label: 'Book a Consultation', href: '/contact' }}
	>
		<ServicesPipelineGraphic slot="media" />
	</Hero>

	<HowItWorks />

	<section class="bg-surface py-16 md:py-24">
		<Container class="flex flex-col gap-10">
			<SectionHeading title="Everything we do, in one place" align="left" class="mx-0" />

			<nav
				aria-label="Jump to a service"
				class="sticky top-20 z-30 -mx-4 flex gap-2 overflow-x-auto border-y border-border-subtle bg-surface/95 px-4 py-3 backdrop-blur-sm sm:mx-0 sm:flex-wrap sm:overflow-visible sm:rounded-full sm:border sm:px-3"
			>
				{
					services.map((service) => (
						<a
							href={`#${service.slug}`}
							data-jump-link={service.slug}
							class="inline-flex flex-none items-center rounded-full border border-border-subtle px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.14em] text-muted transition-colors duration-200 hover:border-primary/40 hover:text-primary aria-[current=true]:border-transparent aria-[current=true]:bg-primary aria-[current=true]:text-surface"
						>
							{service.category}
						</a>
					))
				}
			</nav>

			<div class="flex flex-col border-t border-border-subtle">
				{
					services.map((service, index) => {
						return (
							<div
								id={service.slug}
								data-reveal
								style={`transition-delay: ${Math.min(index, 4) * 80}ms`}
								class="flex scroll-mt-40 flex-col gap-6 border-b border-border-subtle py-10 md:flex-row md:gap-12 md:py-12"
							>
								<div class="flex flex-none items-start gap-4 md:w-72">
									<span class="inline-flex h-12 w-12 flex-none items-center justify-center rounded-lg bg-primary/8 text-primary">
										<Icon name={service.icon} class="h-5 w-5" />
									</span>
									<div class="flex flex-col gap-1.5">
										<span class="text-xs font-semibold uppercase tracking-[0.16em] text-faint">{service.category}</span>
										<h3 class="font-display text-2xl font-semibold leading-[1.15] text-primary md:text-[1.75rem]">
											{service.title}
										</h3>
									</div>
								</div>

								<div class="flex flex-1 flex-col gap-6">
									{service.description && (
										<p class="max-w-[65ch] text-lg leading-[1.6] text-muted">{service.description}</p>
									)}

									{service.groups?.map((group) => (
										<div class="flex flex-col gap-3">
											{group.label && (
												<span class="text-xs font-semibold uppercase tracking-[0.16em] text-primary">{group.label}</span>
											)}
											<ul class="grid grid-cols-1 gap-x-8 gap-y-2.5 sm:grid-cols-2">
												{group.items.map((item) => (
													<li class="flex items-start gap-2.5 leading-[1.5] text-ink">
														<Icon name="check" class="mt-1 h-4 w-4 flex-none text-accent" />
														<span>{item}</span>
													</li>
												))}
											</ul>
										</div>
									))}

									{service.note && <p class="max-w-[65ch] text-sm leading-[1.5] text-muted">{service.note}</p>}
								</div>
							</div>
						);
					})
				}
			</div>
		</Container>
	</section>

	<section class="bg-surface-alt py-16 md:py-24">
		<Container class="flex flex-col gap-10">
			<SectionHeading title="Industries we serve" align="left" class="mx-0" />
			<div
				class="group relative -mx-4 overflow-hidden px-4 [mask-image:linear-gradient(to_right,transparent,black_2rem,black_calc(100%-2rem),transparent)] sm:-mx-6 sm:px-6 md:-mx-8 md:px-8 motion-reduce:overflow-visible motion-reduce:[mask-image:none]"
				data-reveal
			>
				<ul
					class="flex w-max animate-marquee gap-3 group-hover:[animation-play-state:paused] motion-reduce:w-full motion-reduce:flex-wrap motion-reduce:animate-none"
					aria-label="Industries we serve"
				>
					{
						marqueeItems.map((industry, index) => (
							<li class="flex-none" aria-hidden={index >= industries.length ? 'true' : undefined}>
								<span class="inline-flex items-center whitespace-nowrap rounded-full border border-border-subtle bg-surface px-5 py-2.5 text-sm font-medium text-primary">
									{industry}
								</span>
							</li>
						))
					}
				</ul>
			</div>
		</Container>
	</section>

	<CTASection
		title="Not sure which service you need?"
		subtitle="Talk to our advisory team — we'll map the right mix of compliance, protection, and growth services to your business."
		ctaLabel="Talk to Our Team"
		ctaHref="/contact"
	/>

	<script>
		const jumpLinks = document.querySelectorAll<HTMLAnchorElement>('[data-jump-link]');
		const rows = document.querySelectorAll<HTMLElement>('[id][data-reveal]');
		if (jumpLinks.length && rows.length) {
			const setActive = (slug: string | null) => {
				for (const link of jumpLinks) {
					link.setAttribute('aria-current', link.dataset.jumpLink === slug ? 'true' : 'false');
				}
			};
			const observer = new IntersectionObserver(
				(entries) => {
					const visible = entries.filter((entry) => entry.isIntersecting);
					if (visible.length) setActive(visible[0].target.id);
				},
				{ rootMargin: '-45% 0px -45% 0px' },
			);
			for (const row of rows) observer.observe(row);
		}
	</script>
</MainLayout>
