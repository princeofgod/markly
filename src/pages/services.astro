---
import MainLayout from '../layouts/MainLayout.astro';
import Container from '../components/layout/Container.astro';
import Hero from '../components/sections/Hero.astro';
import CTASection from '../components/sections/CTASection.astro';
import SectionHeading from '../components/common/SectionHeading.astro';
import Icon from '../components/icons/Icon.astro';
import { services } from '../data/services';
import { industries } from '../data/industries';
---

<MainLayout
	title="Services"
	description="Data protection compliance, startup and business advisory, brand enforcement, global trademark registration, intellectual property, training, and continuous compliance monitoring — every engagement drafted with AI and countersigned by a human expert."
>
	<Hero
		variant="compact"
		tone="light"
		title="A full-service advisory practice, built for compliance, protection, and growth."
		subtitle="From data protection to trademarks to startup advisory, every engagement is drafted with AI and countersigned by a licensed professional before it reaches you."
		primaryCta={{ label: 'Book a Consultation', href: '/contact' }}
	/>

	<section class="bg-surface py-16 md:py-24">
		<Container class="flex flex-col gap-10">
			<h2 class="font-display text-xl text-primary sm:text-2xl">Schedule of Services</h2>

			<nav
				aria-label="Jump to a service"
				class="sticky top-20 z-30 -mx-4 flex gap-2 overflow-x-auto border-y border-border-subtle bg-surface/95 px-4 py-3 backdrop-blur-sm sm:mx-0 sm:flex-wrap sm:overflow-visible sm:rounded-full sm:px-3"
			>
				{
					services.map((service, index) => (
						<a
							href={`#${service.slug}`}
							data-jump-link={service.slug}
							class="inline-flex flex-none items-center gap-1.5 rounded-full border border-border-subtle px-3 py-1.5 text-xs font-semibold uppercase tracking-wide text-muted transition-colors duration-200 hover:border-primary/40 hover:text-primary aria-[current=true]:border-primary/40 aria-[current=true]:text-primary"
						>
							<span class="font-display text-sm text-primary">§{String(index + 1).padStart(2, '0')}</span>
							{service.category}
						</a>
					))
				}
			</nav>

			<div class="flex flex-col border-t border-border-subtle">
				{
					services.map((service, index) => {
						const visibleCount = 4;
						return (
							<div
								id={service.slug}
								data-reveal
								style={`transition-delay: ${Math.min(index, 4) * 80}ms`}
								class="flex scroll-mt-40 flex-col gap-6 border-b border-border-subtle py-10 md:flex-row md:gap-10 md:py-12"
							>
								<div class="flex flex-none items-start gap-4 md:w-64">
									<span
										data-reveal="seal"
										style={`transition-delay: ${Math.min(index, 4) * 80 + 200}ms`}
										class="relative inline-flex h-11 w-11 flex-none items-center justify-center rounded-full border-[3px] border-double border-primary/35 bg-surface text-primary"
									>
										<Icon name={service.icon} class="h-4.5 w-4.5" />
										<span class="absolute -right-0.5 -top-0.5 h-2.5 w-2.5 rounded-full bg-accent ring-2 ring-surface" aria-hidden="true" />
									</span>
									<div class="flex flex-col gap-1">
										<span class="flex items-baseline gap-1.5">
											<span class="font-display text-sm text-primary/70">§{String(index + 1).padStart(2, '0')}</span>
											<span class="text-sm font-semibold uppercase tracking-wide text-muted">{service.category}</span>
										</span>
										<h3 class="font-display text-2xl text-primary md:text-3xl">{service.title}</h3>
									</div>
								</div>

								<div class="flex flex-1 flex-col gap-6">
									{service.description && (
										<p class="max-w-[65ch] leading-[1.5] text-muted">{service.description}</p>
									)}

									{service.groups?.map((group) => {
										const hasMore = group.items.length > visibleCount;
										const visibleItems = hasMore ? group.items.slice(0, visibleCount) : group.items;
										const restItems = hasMore ? group.items.slice(visibleCount) : [];

										return (
											<div class="flex flex-col gap-3">
												{group.label && (
													<span class="text-sm font-semibold uppercase tracking-wide text-primary">{group.label}</span>
												)}
												<ul class="grid grid-cols-1 gap-x-8 gap-y-2 sm:grid-cols-2">
													{visibleItems.map((item) => (
														<li class="flex items-start gap-2 leading-[1.5] text-primary">
															<Icon name="check" class="mt-1 h-4 w-4 flex-none text-accent" />
															<span>{item}</span>
														</li>
													))}
												</ul>
												{hasMore && (
													<details class="group">
														<summary class="flex w-fit cursor-pointer list-none items-center gap-1.5 rounded-sm text-sm font-semibold text-primary [&::-webkit-details-marker]:hidden focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
															<span class="group-open:hidden">+{restItems.length} more</span>
															<span class="hidden group-open:inline">Show less</span>
															<Icon
																name="chevron-down"
																class="h-4 w-4 flex-none transition-transform duration-200 motion-reduce:transition-none group-open:rotate-180"
															/>
														</summary>
														<ul class="mt-3 grid grid-cols-1 gap-x-8 gap-y-2 sm:grid-cols-2">
															{restItems.map((item) => (
																<li class="flex items-start gap-2 leading-[1.5] text-primary">
																	<Icon name="check" class="mt-1 h-4 w-4 flex-none text-accent" />
																	<span>{item}</span>
																</li>
															))}
														</ul>
													</details>
												)}
											</div>
										);
									})}

									{service.note && <p class="max-w-[65ch] text-sm leading-[1.5] text-muted">{service.note}</p>}
								</div>
							</div>
						);
					})
				}
			</div>
		</Container>
	</section>

	<section class="bg-surface-alt py-16 md:py-24">
		<Container class="flex flex-col gap-10">
			<SectionHeading title="Industries We Serve" align="left" class="mx-0" />
			<div
				class="group relative -mx-4 overflow-hidden px-4 [mask-image:linear-gradient(to_right,transparent,black_2rem,black_calc(100%-2rem),transparent)] sm:-mx-6 sm:px-6 md:-mx-8 md:px-8 motion-reduce:overflow-visible motion-reduce:[mask-image:none]"
				data-reveal
			>
				<div class="flex w-max animate-ledger-scroll group-hover:[animation-play-state:paused] motion-reduce:w-full motion-reduce:animate-none">
					<ul class="flex flex-none motion-reduce:flex-wrap motion-reduce:gap-3" aria-label="Industries we serve">
						{
							industries.map((industry) => (
								<li class="mr-3 flex-none motion-reduce:mr-0">
									<span class="inline-flex items-center whitespace-nowrap rounded-full border border-border-subtle bg-surface px-4 py-2 text-sm font-medium text-primary">
										{industry}
									</span>
								</li>
							))
						}
					</ul>
					<ul class="flex flex-none motion-reduce:hidden" aria-hidden="true">
						{
							industries.map((industry) => (
								<li class="mr-3 flex-none">
									<span class="inline-flex items-center whitespace-nowrap rounded-full border border-border-subtle bg-surface px-4 py-2 text-sm font-medium text-primary">
										{industry}
									</span>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</Container>
	</section>

	<CTASection
		title="Not Sure Which Service You Need?"
		subtitle="Talk to our advisory team — we'll map the right mix of compliance, protection, and growth services to your business."
		ctaLabel="Talk to Our Team"
		ctaHref="/contact"
	/>

	<script>
		const jumpLinks = document.querySelectorAll<HTMLAnchorElement>('[data-jump-link]');
		const rows = document.querySelectorAll<HTMLElement>('[id][data-reveal]');
		if (jumpLinks.length && rows.length) {
			const setActive = (slug: string | null) => {
				for (const link of jumpLinks) {
					link.setAttribute('aria-current', link.dataset.jumpLink === slug ? 'true' : 'false');
				}
			};
			const observer = new IntersectionObserver(
				(entries) => {
					const visible = entries.filter((entry) => entry.isIntersecting);
					if (visible.length) setActive(visible[0].target.id);
				},
				{ rootMargin: '-45% 0px -45% 0px' },
			);
			for (const row of rows) observer.observe(row);
		}
	</script>
</MainLayout>
