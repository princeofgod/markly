---
import { PortableText } from 'astro-portabletext';
import MainLayout from '../../layouts/MainLayout.astro';
import Container from '../../components/layout/Container.astro';
import CTASection from '../../components/sections/CTASection.astro';
import PortableImage from '../../components/insights/PortableImage.astro';
import { getArticlesWithBody, imageUrl } from '../../lib/sanity';
import { buildArticleSchema } from '../../lib/structuredData';
import type { Article } from '../../types';

export async function getStaticPaths() {
	const articles = await getArticlesWithBody();
	return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

interface Props {
	article: Article;
}

const { article } = Astro.props;
const { title, excerpt, coverImage, category, publishedAt, author, body, seoTitle, seoDescription } = article;

const date = new Date(publishedAt);
const dateLabel = date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const ogImage = coverImage?.url ? imageUrl(coverImage.url, { w: 1200, h: 630 }) : undefined;
---

<MainLayout
	title={seoTitle || title}
	description={seoDescription || excerpt}
	ogImage={ogImage}
	jsonLd={buildArticleSchema(article)}
>
	<article>
		<header class="bg-surface pt-14 pb-10 md:pt-20 md:pb-12">
			<Container>
				<div class="mx-auto flex max-w-3xl flex-col gap-5">
					<a
						href="/insights"
						class="inline-flex w-fit items-center gap-1.5 text-sm font-semibold text-muted transition-colors duration-300 hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
					>
						<span aria-hidden="true">&larr;</span> All insights
					</a>

					<div class="flex flex-wrap items-center gap-2.5 text-xs font-semibold text-primary/60">
						<span>{category}</span>
						<span class="h-1 w-1 flex-none rounded-full bg-accent" aria-hidden="true"></span>
						<time datetime={publishedAt} class="font-medium text-muted">{dateLabel}</time>
					</div>

					<h1 class="font-display text-[2.25rem] font-semibold leading-[1.08] text-primary sm:text-[2.75rem] md:text-[3.25rem]">
						{title}
					</h1>

					<p class="max-w-[62ch] text-lg leading-[1.6] text-muted">{excerpt}</p>

					{
						author?.name && (
							<div class="mt-2 flex items-center gap-3 border-t border-border-subtle pt-5">
								{author.avatarUrl ? (
									<img
										src={imageUrl(author.avatarUrl, { w: 80, h: 80 })}
										alt=""
										width="40"
										height="40"
										loading="lazy"
										class="h-10 w-10 flex-none rounded-full object-cover"
									/>
								) : (
									<span
										class="inline-flex h-10 w-10 flex-none items-center justify-center rounded-full bg-accent font-display text-base font-semibold text-primary"
										aria-hidden="true"
									>
										{author.name.charAt(0)}
									</span>
								)}
								<span class="flex flex-col">
									<span class="text-sm font-semibold text-primary">{author.name}</span>
									{author.role && <span class="text-sm text-muted">{author.role}</span>}
								</span>
							</div>
						)
					}
				</div>
			</Container>
		</header>

		{
			coverImage?.url && (
				<div class="bg-surface pb-12 md:pb-16">
					<Container>
						<img
							src={imageUrl(coverImage.url, { w: 1600, h: 900 })}
							alt={coverImage.alt || ''}
							width="1600"
							height="900"
							loading="eager"
							fetchpriority="high"
							decoding="async"
							class="mx-auto aspect-[16/9] w-full max-w-4xl rounded-xl border border-border-subtle object-cover"
						/>
					</Container>
				</div>
			)
		}

		<div class="bg-surface pb-20 md:pb-28">
			<Container>
				<div class="article-body mx-auto max-w-[68ch]">
					<PortableText value={body} components={{ type: { image: PortableImage } }} />
				</div>
			</Container>
		</div>
	</article>

	<CTASection
		title="Need help applying this to your business?"
		subtitle="Talk to our advisory team about compliance, intellectual property, and growth strategy tailored to your business."
		ctaLabel="Book a Consultation"
		ctaHref="/contact"
	/>
</MainLayout>
