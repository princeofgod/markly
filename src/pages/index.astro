---
import MainLayout from '../layouts/MainLayout.astro';
import HeroBloom from '../components/sections/HeroBloom.astro';
import BrandPositioning from '../components/sections/BrandPositioning.astro';
import ServicesOverview from '../components/sections/ServicesOverview.astro';
import WhyChooseUs from '../components/sections/WhyChooseUs.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import IndustriesServed from '../components/sections/IndustriesServed.astro';
import CTASection from '../components/sections/CTASection.astro';
---

<MainLayout
	title="Compliance, IP Protection & Business Advisory"
	description="Markly Africa helps businesses, startups, and innovators navigate data protection, regulatory compliance, intellectual property, and business growth with practical, AI-driven solutions."
>
	<HeroBloom />

	<BrandPositioning />

	<ServicesOverview />

	<WhyChooseUs />

	<Testimonials />

	<IndustriesServed />

	<CTASection
		title="Ready to protect your business and scale with confidence?"
		subtitle="Talk to our advisory team about compliance, intellectual property, and growth strategy tailored to your business."
		ctaLabel="Book a Consultation"
		ctaHref="/contact"
	/>
</MainLayout>
