---
import '../styles/global.css';
// Self-hosted fonts (no Google CDN → no visitor-IP leak to Google, faster: no extra
// connection). Only the weights actually used are loaded: Hanken 400/500/600, Petrona 500/600
// — and only the `latin` subset (the site is English; latin-ext/vietnamese are dropped).
import '@fontsource/hanken-grotesk/latin-400.css';
import '@fontsource/hanken-grotesk/latin-500.css';
import '@fontsource/hanken-grotesk/latin-600.css';
import '@fontsource/petrona/latin-500.css';
import '@fontsource/petrona/latin-600.css';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import { buildSeo } from '../lib/seo';
import { organizationSchema } from '../lib/structuredData';

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
	noIndex?: boolean;
	/** Optional page-specific JSON-LD (e.g. FAQPage), emitted alongside the site-wide organization schema. */
	jsonLd?: object | object[];
}

const { title, description, ogImage, noIndex = false, jsonLd } = Astro.props;
const seo = buildSeo({ title, description, ogImage, path: Astro.url.pathname });
const structuredData = [organizationSchema, ...(jsonLd ? [jsonLd].flat() : [])];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#2D106C" />

		<title>{seo.title}</title>
		<meta name="description" content={seo.description} />
		{noIndex && <meta name="robots" content="noindex, nofollow" />}
		<link rel="canonical" href={seo.canonicalUrl} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Markly Africa" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={seo.title} />
		<meta property="og:description" content={seo.description} />
		<meta property="og:url" content={seo.canonicalUrl} />
		<meta property="og:image" content={seo.ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={seo.title} />
		<meta name="twitter:description" content={seo.description} />
		<meta name="twitter:image" content={seo.ogImage} />

		<meta name="generator" content={Astro.generator} />

		{
			structuredData.map((schema) => (
				<script type="application/ld+json" set:html={JSON.stringify(schema)} />
			))
		}
	</head>
	<body class="min-h-screen bg-surface font-body text-primary antialiased">
		<Navbar />
		<main>
			<slot />
		</main>
		<Footer />
			<script>
				const revealEls = document.querySelectorAll('[data-reveal], [data-reveal-group]');
				if (revealEls.length) {
					const observer = new IntersectionObserver(
						(entries, obs) => {
							for (const entry of entries) {
								if (entry.isIntersecting) {
									entry.target.classList.add('is-visible');
									obs.unobserve(entry.target);
								}
							}
						},
						{ threshold: 0.2, rootMargin: '0px 0px -10% 0px' },
					);
					for (const el of revealEls) observer.observe(el);
				}
			</script>
	</body>
</html>
